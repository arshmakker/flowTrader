# Shoonya API Credentials Template
# Rename this file to cred.yml and fill in your credentials

user: "YOUR_USER_ID"        # Your Shoonya trading account ID
pwd: "YOUR_PASSWORD"        # Your trading password
vc: "YOUR_VENDOR_CODE"      # Your vendor code from Shoonya
apikey: "YOUR_API_KEY"      # Your API key from Shoonya
imei: "YOUR_IMEI"          # Any unique identifier 