# Shoonya API Credentials Template
# Rename this file to cred.yml and fill in one of the modes below.
# Keep cred.yml local-only (already gitignored).

# -------------------------------------------------------------------
# MODE 1: Legacy login (userid/password/2FA/vendor/api_secret/imei)
# -------------------------------------------------------------------
# user: "YOUR_USER_ID"
# pwd: "YOUR_PASSWORD"
# vc: "YOUR_VENDOR_CODE"
# apikey: "YOUR_API_SECRET"
# imei: "YOUR_IMEI_OR_DEVICE_ID"

# -------------------------------------------------------------------
# MODE 2: OAuth login (recommended for token reuse across restarts)
# -------------------------------------------------------------------
UID: "YOUR_USER_ID"
client_id: "YOUR_CLIENT_ID_U"
oauth_url: "https://trade.shoonya.com/NorenWeb/authorize/oauth"
Secret_Code: "YOUR_SECRET_CODE"
token_url: "https://api.shoonya.com/NorenWClientAPI//GenAcsTok"
oauth_api_host: "https://api.shoonya.com/NorenWClientAPI/"
oauth_ws_endpoint: "wss://api.shoonya.com/NorenWS/"
oauth_reauth_attempts: 2

# Runtime-managed token cache fields (do not prefill manually):
Access_token: ""
Account_ID: ""

# Optional: auto-fetch auth code by running an external command/script.
# If set, app will execute this command before prompting manual auth code.
# Example:
# auth_code_cmd: "python3 /Users/arshdeep/git/Shoonya_oAuth_API.py/tests/getAuthCode.py"
# auth_code_timeout: 180

# Preferred: in-process Selenium auth (runs headless Chrome inside main.py
# so the OAuth token exchange fires immediately after auth_code capture,
# avoiding race conditions against the browser's own redirect).
# Requires: selenium and pyotp (already in requirements.txt).
# selenium_user_id: "YOUR_USER_ID"
# selenium_password: "YOUR_PASSWORD"
# selenium_totp_secret: "YOUR_TOTP_BASE32_SECRET"
# Optional override; default uses Shoonya's investor-entry-level login URL:
# selenium_login_url_template: "https://trade.shoonya.com/OAuthlogin/investor-entry-level/login?api_key={client_id}&route_to=abc"